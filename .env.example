# Copy this file to .env for local development.
# NEVER commit your real API key to GitHub.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# VOXYFY model. The backend maps this short name to OpenRouter's full model slug.
VOXYFY_MODEL=gpt-5.6-sol

# Optional, used only for OpenRouter attribution headers.
VOXYFY_SITE_URL=https://voxyfy.onrender.com

PORT=5000
